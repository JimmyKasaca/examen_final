<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="unicah_prestamo_equipo_list" model="ir.ui.view">
        <field name="name">unicah.prestamo.equipo.list</field>
        <field name="model">unicah.prestamo.equipo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="solicitante_id"/>
                <field name="aula"/>
                <field name="fecha_prestamo"/>
                <field name="fecha_devolucion"/>
                <field name="dias_prestamo"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="unicah_prestamo_equipo_form" model="ir.ui.view">
        <field name="name">unicah.prestamo.equipo.form</field>
        <field name="model">unicah.prestamo.equipo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="solicitante_id"/>
                            <field name="aula"/>
                        </group>
                        <group>
                            <field name="fecha_prestamo"/>
                            <field name="fecha_devolucion"/>
                            <field name="dias_prestamo"/>
                            <field name="estado"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="unicah_prestamo_equipo_action" model="ir.actions.act_window">
        <field name="name">Préstamos de Equipo</field>
        <field name="res_model">unicah.prestamo.equipo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="unicah_prestamo_equipo_menu"
              name="Préstamos Equipo UNICAH"
              action="unicah_prestamo_equipo_action"
              sequence="10"/>

    <record id="view_partner_form_prestamo_equipo" model="ir.ui.view">
        <field name="name">res.partner.form.prestamo.equipo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="total_prestamos"/>
            </field>
        </field>
    </record>
</odoo>
